{
  "name": "ooerflix",
  "private": true,
  "license": "SEE LICENSE IN LICENCE",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4390",
    "format": "prettier --write .",
    "types": "astro check",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "check:quick": "npm run --silent secrets && prettier --check . && astro check && eslint . && vitest run",
    "check": "npm run check:quick && npm run build && npm run test:e2e && npm run look && npm run weight",
    "secrets": "gitleaks git --pre-commit --staged --redact --verbose --no-banner",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "test:e2e": "playwright test --project=e2e",
    "headers": "node scripts/headers.mjs",
    "look": "playwright test --project=look",
    "look:update": "playwright test --project=look --update-snapshots",
    "weight": "playwright test --project=weight",
    "weight:update": "WEIGHT_UPDATE=1 playwright test --project=weight",
    "links": "node scripts/links.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "astro": "7.4.13",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
