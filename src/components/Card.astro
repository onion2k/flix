---
// One card in a row's strip, with two faces. The front is the picture, a plain
// label line and the title; the back is the label and the title again, the
// description, the Play link (where the entry has an address: "Play <title>",
// named with the new-window words, with the icon that says so by sight, opening
// in a new window cut from this one) and a Close button. Without script, and
// until it runs, the two faces flow one under the other with the back's repeat
// of the label and the title kept out of sight and out of the accessibility
// tree, so each word is drawn once, and the Play link's stretched ::after makes
// the whole card its hit area, so the card is one link as it always was and
// none is nested; where there is no address there is no link and the card is
// not a control. The two buttons are written hidden, since without script they
// would do nothing: src/scripts/flip.ts shows them, and then the front's
// button covers the front and turns the card over, and the back's covers the
// back under Play and turns it back. Without this each row would repeat the
// markup, and one that forgot the alt words or a name would be the odd one out.
// A late card (see Row.astro) writes its picture with the addresses in data-
// attributes, which no browser fetches, and the ordinary picture in a
// <noscript>, so that script brings the one in and no script has the other. It
// also carries the colour of its picture, which the frame waits in.
import { Picture, getImage } from 'astro:assets';
import type { Card } from '../catalogue/rows';
import { pictureColour } from '../build/picture-colour';
import { loopFor } from '../build/loops';
import NewWindowIcon from './NewWindowIcon.astro';

interface Props {
  card: Card<ImageMetadata>;
  /** True for a picture the first screen draws, which must not wait. */
  eager: boolean;
  /** True for a picture that waits for script, with its plain one in a noscript. */
  late: boolean;
}

const { card, eager, late } = Astro.props;

// The address the build gave the card's loop, if it has one. It is written as
// an attribute and nothing more, which no browser fetches: it is kept for the
// script that will play the loop of the card most in view (part 4 of
// plans/cards.md), and nothing reads it until then.
const loop = card.loop === undefined ? undefined : loopFor(card.id, card.loop);

// What the card's width is at each window width, as the stylesheet makes it:
// the whole window less two gutters below 340px, 58vw on a phone, then
// clamp(17rem, 27vw, 25rem).
const sizes =
  '(width < 21.25rem) calc(100vw - 2rem), (max-width: 40rem) 58vw, (max-width: 63rem) 17rem, (max-width: 92.6rem) 27vw, 25rem';

// The widths and formats of a card's picture, said once so that the late
// picture's sources and the ordinary one cannot differ.
const widths = [320, 480, 640, 800];
const shared = {
  src: card.picture,
  width: 1280,
  height: 720,
  widths,
  sizes,
};
// The colour the frame waits in, read from the picture's own file at build.
// Astro gives the file's path as fsPath on what image() returns, set so that it
// does not show when the object is listed, so it is asked for by name, and a
// picture without one stops the build and names the entry.
const fsPath = (card.picture as ImageMetadata & { fsPath?: string }).fsPath;
if (late && fsPath === undefined)
  throw new Error(`${card.id}: Astro gave no file path for the picture`);
const waiting = late && fsPath ? await pictureColour(fsPath) : undefined;

// The Play link's words, split before the last so that the last word and the
// icon after it go in a span that may not break, as OutsideLink.astro does for
// every other link that leaves: the icon is never alone at the start of a line.
const words = card.linkText ?? '';
const head = words.slice(0, words.lastIndexOf(' ') + 1);
const tail = words.slice(words.lastIndexOf(' ') + 1);

// The same three files <Picture> would make (AVIF, WebP, then the JPEG that
// is the fallback), written here so that their addresses can go in data-
// attributes instead of src and srcset.
const [avif, webp, jpeg] = late
  ? await Promise.all([
      getImage({ ...shared, format: 'avif' }),
      getImage({ ...shared, format: 'webp' }),
      getImage({ ...shared, format: 'jpeg' }),
    ])
  : [];
---

<li
  class="card"
  data-entry={card.id}
  data-linked={card.href ? '' : undefined}
  data-loop={loop}
>
  <div class="card-faces">
    <div class="face front">
      {late && avif && webp && jpeg ? (
        <div class="frame" data-late data-waiting={waiting}>
          <picture>
            <source
              data-srcset={avif.srcSet.attribute}
              type="image/avif"
              sizes={sizes}
            />
            <source
              data-srcset={webp.srcSet.attribute}
              type="image/webp"
              sizes={sizes}
            />
            <img
              data-src={jpeg.src}
              data-srcset={jpeg.srcSet.attribute}
              data-alt={card.pictureAlt}
              alt=""
              sizes={sizes}
              width={1280}
              height={720}
              decoding="async"
            />
          </picture>
          <noscript>
            <Picture
              {...shared}
              alt={card.pictureAlt}
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              loading="lazy"
              decoding="async"
            />
          </noscript>
        </div>
      ) : (
        <Picture
          {...shared}
          alt={card.pictureAlt}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          pictureAttributes={{ class: 'frame' }}
        />
      )}
      <p class="label" data-label>
        {card.label}
      </p>
      <h3 class="card-title">{card.title}</h3>
      <button type="button" class="card-flip" hidden>
        <span class="visually-hidden">{card.aboutName}</span>
      </button>
    </div>
    <div class="face back">
      <p class="label" data-repeat>
        {card.label}
      </p>
      <p class="card-title" data-repeat>
        {card.title}
      </p>
      <p class="description">{card.description}</p>
      <div class="card-actions">
        {card.href && card.linkText ? (
          <a
            class="card-link button"
            href={card.href}
            target="_blank"
            rel="noopener"
            aria-label={card.linkName}
          >
            <span>
              {head}
              <span class="keep-together">
                {tail}
                <NewWindowIcon />
              </span>
            </span>
          </a>
        ) : null}
        <button type="button" class="card-unflip" hidden>
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path
              d="M3 3l10 10M13 3L3 13"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="square"
            ></path>
          </svg>
          <span class="visually-hidden">{card.closeName}</span>
        </button>
      </div>
    </div>
  </div>
</li>
