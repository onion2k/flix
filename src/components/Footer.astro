---
// The footer every page ends in, which is the page's contentinfo: a link to the
// privacy page, the licence the site is given under (words and pictures
// CC BY 4.0, code MIT, each licence a link marked rel="license" so that a
// reader or a crawler can find it), and a link to the source. The last three
// leave the site, so each opens in a new window and says so. Drawn by
// Base.astro, so no page can forget it. Without it the site would state no
// licence where a visitor looks and the privacy page would be linked from
// nowhere.
import OutsideLink from './OutsideLink.astro';
---

<footer class="site-footer">
  <a href="/privacy/">Privacy</a>
  <p>
    Words and pictures{' '}
    <OutsideLink
      href="https://creativecommons.org/licenses/by/4.0/"
      rel="license"
    >
      CC BY 4.0
    </OutsideLink>
    , code{' '}
    <OutsideLink href="https://opensource.org/license/mit" rel="license">
      MIT
    </OutsideLink>
  </p>
  <OutsideLink href="https://github.com/onion2k/flix">Source</OutsideLink>
</footer>
