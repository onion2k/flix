---
// The featured entry: its picture beside a panel of words, stacked on a
// phone. With no list of features it is one section whose picture loads at
// once and at high priority, since it is the largest thing the first screen
// draws. With a list (src/content/catalogue.json) it is one section for each
// candidate, in order, all but the first hidden, and each picture written as
// a late card's is: its addresses in data- attributes, which no browser
// fetches, so that the markup alone fetches nothing, and the first also holds
// the ordinary picture in a <noscript>, which is what shows with script off. A
// small inline script straight after them (src/scripts/today-inline.js) picks
// the day's, shows it and fills its picture before the page is first drawn.
// Without this the home page would have no first thing to look at, or would
// fetch the big picture of every candidate.
import { Picture, getImage } from 'astro:assets';
import type { Card } from '../catalogue/rows';
import OutsideLink from './OutsideLink.astro';
import inlineScript from '../scripts/today-inline.js?raw';

interface Props {
  /** The candidates, in order: the feature, then each of the list. */
  cards: Card<ImageMetadata>[];
}

const { cards } = Astro.props;
const listed = cards.length > 1;

// The picture is seven twelfths of the window less the gutters, and the whole
// of it less the gutters below 64rem, where the grid has one column (and the
// gutters are the phone's below 40rem). These follow site.css's steps, so
// that the browser fetches the width it will draw.
const sizes =
  '(max-width: 40rem) calc(100vw - 2rem), (max-width: 64rem) calc(100vw - 6rem), calc((100vw - 6rem) * 7 / 12)';

// The widths and formats of a picture, said once so that the ordinary picture
// and a late one's sources cannot differ.
const widths = [640, 960, 1280];

// The feature is the largest picture on the first screen, so it is drawn a
// little lighter than Astro's own 50. The owner chose 40 on 2026-11-22 from
// Aquaclysm's painted title shown both ways, enlarged, where the difference
// was hard to see: 61,772 bytes at 960 wide became 43,125, which is what
// keeps the first screen inside its budget (gates/weight.json).
const quality = 40;

// With a list, the three files <Picture> would make (AVIF, WebP, then the JPEG
// that is the fallback) for each candidate, written here so that their
// addresses can go in data- attributes instead of src and srcset.
const files = listed
  ? await Promise.all(
      cards.map(async (card) => {
        const shared = {
          src: card.picture,
          width: 1280,
          height: 720,
          widths,
          sizes,
          quality,
        };
        const [avif, webp, jpeg] = await Promise.all([
          getImage({ ...shared, format: 'avif' }),
          getImage({ ...shared, format: 'webp' }),
          getImage({ ...shared, format: 'jpeg' }),
        ]);
        return { avif, webp, jpeg };
      }),
    )
  : [];
---

{listed ? (
  <>
    {cards.map((card, at) => {
      const found = files[at];
      return (
        <section
          class="feature"
          aria-labelledby={`feature-title-${at}`}
          data-entry={card.id}
          data-place={at}
          hidden={at > 0}
        >
          <div class="feature-frame">
            <picture class="feature-picture">
              <source
                data-srcset={found?.avif.srcSet.attribute}
                type="image/avif"
                sizes={sizes}
              />
              <source
                data-srcset={found?.webp.srcSet.attribute}
                type="image/webp"
                sizes={sizes}
              />
              <img
                data-src={found?.jpeg.src}
                data-srcset={found?.jpeg.srcSet.attribute}
                alt={card.pictureAlt}
                sizes={sizes}
                width={1280}
                height={720}
                decoding="async"
              />
            </picture>
            {at === 0 ? (
              <noscript>
                <Picture
                  src={card.picture}
                  alt={card.pictureAlt}
                  width={1280}
                  height={720}
                  widths={widths}
                  sizes={sizes}
                  quality={quality}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpeg"
                  priority
                  pictureAttributes={{ class: 'feature-picture' }}
                />
              </noscript>
            ) : null}
          </div>
          <div class="words">
            <p class="label" data-label>
              {card.label}
            </p>
            <h2 id={`feature-title-${at}`}>{card.title}</h2>
            <p class="description">{card.description}</p>
            {card.href ? (
              <OutsideLink class="button" href={card.href}>
                {card.linkText}
              </OutsideLink>
            ) : null}
          </div>
        </section>
      );
    })}
    <script is:inline set:html={inlineScript} />
  </>
) : (
  cards.map((card) => (
    <section
      class="feature"
      aria-labelledby="feature-title"
      data-entry={card.id}
    >
      <Picture
        src={card.picture}
        alt={card.pictureAlt}
        width={1280}
        height={720}
        widths={widths}
        sizes={sizes}
        quality={quality}
        formats={['avif', 'webp']}
        fallbackFormat="jpeg"
        priority
        pictureAttributes={{ class: 'feature-picture' }}
      />
      <div class="words">
        <p class="label" data-label>
          {card.label}
        </p>
        <h2 id="feature-title">{card.title}</h2>
        <p class="description">{card.description}</p>
        {card.href ? (
          <OutsideLink class="button" href={card.href}>
            {card.linkText}
          </OutsideLink>
        ) : null}
      </div>
    </section>
  ))
)}
