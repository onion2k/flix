---
// The featured entry, drawn as the moving hero: a band across the whole window
// under the header, its picture filling it, its words on a solid panel at the
// lower left and a Pause button at the lower right, and, once the page has
// loaded, its loop playing over the picture (src/scripts/hero.ts). On a phone
// the picture sits above the panel. With no list of features it is one section
// whose picture loads at once and at high priority, since it is the largest
// thing the first screen draws. With a list (src/content/catalogue.json) it is
// one section for each candidate, in order, all but the first hidden, and each
// picture written as a late card's is: its addresses in data- attributes, which
// no browser fetches, so that the markup alone fetches nothing, and the first
// also holds the ordinary picture in a <noscript>, which is what shows with
// script off. A small inline script straight after them
// (src/scripts/today-inline.js) picks the day's, shows it and fills its picture
// before the page is first drawn. Each section carries the built address of its
// hero loop as `data-hero-loop`, an attribute no browser fetches. Without this
// the home page would have no first thing to look at, or would fetch the big
// picture, or the loop, of every candidate.
import { Picture, getImage } from 'astro:assets';
import type { Card } from '../catalogue/rows';
import FeatureWords from './FeatureWords.astro';
import { heroLoopFor } from '../build/loops';
import inlineScript from '../scripts/today-inline.js?raw';

interface Props {
  /** The candidates, in order: the feature, then each of the list. */
  cards: Card<ImageMetadata>[];
}

const { cards } = Astro.props;
const listed = cards.length > 1;

// The picture is the band's whole width at every window size, so the browser
// is told to fetch for the window's width, from the files below, the largest
// of which is the sources' own 1280 and is never made larger than it.
const sizes = '100vw';

// The widths and formats of a picture, said once so that the ordinary picture
// and a late one's sources cannot differ. 1280 is the width of the owner's
// pictures, so a desk's window is drawn from the largest file there is and the
// browser enlarges it; a file is never made from a picture wider than it.
const widths = [640, 960, 1280];

// The feature is the largest picture on the first screen, so it is drawn a
// little lighter than Astro's own 50. The owner chose 40 on 2026-11-22 from
// Aquaclysm's painted title shown both ways, enlarged, where the difference
// was hard to see: 61,772 bytes at 960 wide became 43,125, which is what
// keeps the first screen inside its budget (gates/weight.json).
const quality = 40;

// With a list, the three files <Picture> would make (AVIF, WebP, then the JPEG
// that is the fallback) for each candidate, written here so that their
// addresses can go in data- attributes instead of src and srcset.
const files = listed
  ? await Promise.all(
      cards.map(async (card) => {
        const shared = {
          src: card.picture,
          width: 1280,
          height: 720,
          widths,
          sizes,
          quality,
        };
        const [avif, webp, jpeg] = await Promise.all([
          getImage({ ...shared, format: 'avif' }),
          getImage({ ...shared, format: 'webp' }),
          getImage({ ...shared, format: 'jpeg' }),
        ]);
        return { avif, webp, jpeg };
      }),
    )
  : [];
---

{listed ? (
  <>
    {cards.map((card, at) => {
      const found = files[at];
      return (
        <section
          class="feature"
          aria-labelledby={`feature-title-${at}`}
          data-entry={card.id}
          data-place={at}
          data-hero-loop={
            card.heroLoop === undefined
              ? undefined
              : heroLoopFor(card.id, card.heroLoop)
          }
          hidden={at > 0}
        >
          <div class="feature-frame">
            <picture class="feature-picture">
              <source
                data-srcset={found?.avif.srcSet.attribute}
                type="image/avif"
                sizes={sizes}
              />
              <source
                data-srcset={found?.webp.srcSet.attribute}
                type="image/webp"
                sizes={sizes}
              />
              <img
                data-src={found?.jpeg.src}
                data-srcset={found?.jpeg.srcSet.attribute}
                alt={card.pictureAlt}
                sizes={sizes}
                width={1280}
                height={720}
                decoding="async"
              />
            </picture>
            {at === 0 ? (
              <noscript>
                <Picture
                  src={card.picture}
                  alt={card.pictureAlt}
                  width={1280}
                  height={720}
                  widths={widths}
                  sizes={sizes}
                  quality={quality}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpeg"
                  priority
                  pictureAttributes={{ class: 'feature-picture' }}
                />
              </noscript>
            ) : null}
          </div>
          <FeatureWords card={card} titleId={`feature-title-${at}`} />
        </section>
      );
    })}
    <script is:inline set:html={inlineScript} />
  </>
) : (
  cards.map((card) => (
    <section
      class="feature"
      aria-labelledby="feature-title"
      data-entry={card.id}
      data-hero-loop={
        card.heroLoop === undefined
          ? undefined
          : heroLoopFor(card.id, card.heroLoop)
      }
    >
      <div class="feature-frame">
        <Picture
          src={card.picture}
          alt={card.pictureAlt}
          width={1280}
          height={720}
          widths={widths}
          sizes={sizes}
          quality={quality}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          priority
          pictureAttributes={{ class: 'feature-picture' }}
        />
      </div>
      <FeatureWords card={card} titleId="feature-title" />
    </section>
  ))
)}
