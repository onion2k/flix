---
// The document every page is drawn in: the head (title, description, address,
// social card, icon, the self-hosted fonts and the two stylesheets), the skip
// link, the header (the wordmark alone, the owner's choice: the rows are
// reached by scrolling, and each keeps its id as an address), the main that
// the page's content goes in, and the footer every page ends in. Without it
// each page would repeat the head, and one that forgot the viewport tag, the
// canonical link or the skip link would be the odd one out. Every absolute address is made here from Astro's `site`,
// which astro.config.mjs says once.
import { Font, getImage } from 'astro:assets';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/site.css';

interface Props {
  title: string;
  /** True on the home page, where the wordmark is the h1 and no link. */
  home?: boolean;
  /** The picture the social card shows, and what it shows, in words. */
  card?: { picture: ImageMetadata; alt: string };
  skipLabel?: string;
  /** What the page is, for search results and link previews. */
  description?: string;
  /** True for a page to be found: a canonical address and no noindex. The
   *  home page always is. */
  indexed?: boolean;
}

const {
  title,
  home = false,
  card,
  skipLabel = 'Skip to the games',
  description = 'Games and toys to play in a browser.',
  indexed = home,
} = Astro.props;
const address = new URL(Astro.url.pathname, Astro.site).href;
// Social cards are cut to 1200 by 630, the size they are drawn at, and as a
// JPEG because not every crawler reads a newer format.
const cardImage = card
  ? await getImage({
      src: card.picture,
      width: 1200,
      height: 630,
      format: 'jpeg',
    })
  : undefined;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {indexed ? (
      <>
        <link rel="canonical" href={address} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={address} />
      </>
    ) : (
      <meta name="robots" content="noindex" />
    )}
    {cardImage && card ? (
      <>
        <meta
          property="og:image"
          content={new URL(cardImage.src, Astro.site).href}
        />
        <meta property="og:image:alt" content={card.alt} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    ) : null}
    {/* Both faces are preloaded: the first screen draws titles in one and
        the label, the description and the button in the other, in both its
        weights. Left to be found in the styles, the body face arrives a
        request later and the words are drawn twice. */}
    <Font cssVariable="--face-display" preload />
    <Font cssVariable="--face-body" preload />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {skipLabel}
    </a>
    <header class="site-header">
      {home ? (
        <h1 class="mark">ooerflix</h1>
      ) : (
        <a class="mark" href="/">
          ooerflix
        </a>
      )}
    </header>
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
