---
// The home page. For now only the wordmark, which is the h1. The catalogue is
// loaded and built here all the same, so that a catalogue that does not hold
// together stops the build, naming the file and the id. Without the call the
// cross-file checks would never run, and markup is the next part's.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { buildPage } from '../catalogue/rows';

const entries = await getCollection('entries');
const [rowsFile] = await getCollection('rows');
if (rowsFile === undefined) {
  throw new Error(
    'src/content/rows.yaml is missing, and the page has no rows.',
  );
}

buildPage(
  entries.map((entry) => ({ id: entry.id, ...entry.data })),
  rowsFile.data,
);
---

<Base title="ooerflix">
  <main>
    <h1>ooerflix</h1>
  </main>
</Base>
