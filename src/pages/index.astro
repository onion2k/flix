---
// The home page: the feature, then each row in the order written. The model
// is built by the catalogue, which refuses a catalogue that does not hold
// together, naming the file and the id, so that a broken one stops the build;
// this page only draws what comes back. The page's script, which pages the
// rows, brings in the late rows' pictures, lets a mouse drag a strip, moves
// focus by arrow key and gamepad and works the Surprise me button, is added
// here and nowhere else.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Feature from '../components/Feature.astro';
import Row from '../components/Row.astro';
import { buildPage } from '../catalogue/rows';
import { checkLoops } from '../build/loops';

const entries = await getCollection('entries');
const [config] = await getCollection('catalogue');
if (config === undefined) {
  throw new Error(
    'src/content/catalogue.json is missing, and the page has no rows.',
  );
}

const page = buildPage(
  entries.map((entry) => ({ id: entry.id, ...entry.data })),
  config.data,
);

// Every entry's loop must be a file that is there, listed or not, so a bad one
// stops the build and names its entry even where no card draws it.
checkLoops(entries.map((entry) => ({ id: entry.id, ...entry.data })));

// A site left out is not an error, but it is said once, so that one left out
// by accident is seen. Nothing is said when every site is listed. The line
// starts on a new line because Astro's own build output has an unfinished one
// open while a page is made.
if (page.notListed.length > 0) {
  console.log(
    `\nNot listed in src/content/catalogue.json: ${page.notListed.join(', ')}`,
  );
}
---

<Base
  title="ooerflix"
  home
  rows={page.rows}
  card={{ picture: page.feature.picture, alt: page.feature.pictureAlt }}
>
  <Feature cards={page.candidates} />
  {page.rows.map((row, at) => (
    <Row row={row} at={at} />
  ))}
</Base>

<script>
  import '../scripts/rows';
  import '../scripts/pictures';
  import '../scripts/drag';
  import '../scripts/moving';
  import '../scripts/surprise';
</script>
